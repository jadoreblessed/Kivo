ADMIN_PASSWORD=replace-with-a-long-random-admin-password
ADMIN_SESSION_SECRET=replace-with-a-long-random-session-secret
UPSTASH_REDIS_REST_URL=https://your-database.upstash.io
UPSTASH_REDIS_REST_TOKEN=replace-with-upstash-rest-token
SOLANA_MAINNET_RPC=https://api.mainnet-beta.solana.com
NEXT_PUBLIC_SOLANA_MAINNET_RPC=https://api.mainnet-beta.solana.com
NEXT_PUBLIC_SOLANA_DEVNET_RPC=https://api.devnet.solana.com
SOLANA_MARKET_RPC=https://api.devnet.solana.com
NEXT_PUBLIC_KIVO_NETWORK=devnet
NEXT_PUBLIC_KIVO_PROGRAM_ID=
NEXT_PUBLIC_KIVO_TREASURY=
# Also pass this public address to cargo build-sbf as KIVO_TREASURY_PUBKEY.
# The onchain address is fixed at build time; it must equal NEXT_PUBLIC_KIVO_TREASURY.
KIVO_TREASURY_PUBKEY=
